@model MyChat.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"]="CreateProfile";
}

<div>
    <label asp-for="UserName">Имя пользователя</label>
    <input asp-for="UserName" />
    <span asp-validation-for="UserName"></span>
</div>
<div>
    <label asp-for="Email">Email</label>
    <input asp-for="Email" type="email" />
    <span asp-validation-for="Email"></span>
</div>
<div>
    <label asp-for="BirthOfDate">Дата рождения</label>
    <input asp-for="BirthOfDate" type="date" />
    <span asp-validation-for="BirthOfDate"></span>
</div>
<div>
    <label asp-for="Password">Пароль</label>
    <input asp-for="Password" type="password" />
    <span asp-validation-for="Password"></span>
</div>

<button type="submit">Создать пользователя</button>

